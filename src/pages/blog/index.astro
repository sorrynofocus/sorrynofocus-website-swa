---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagSlug } from '../../lib/posts';
import { blog_pageTitle, blog_pageDescription, blog_postCountSingular, blog_postCountPlural } from '../../consts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title={blog_pageTitle} description={blog_pageDescription}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? blog_postCountSingular : blog_postCountPlural}</p>
      <h1>{blog_pageTitle}</h1>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <section class="section list">
    <div class="container">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .list {
    padding-top: 0;
  }
</style>
