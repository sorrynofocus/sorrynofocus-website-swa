---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  notfound_pageTitle,
  notfound_label,
  notfound_heading,
  notfound_message,
  notfound_buttonLabel,
} from '../consts';
---

<BaseLayout title={notfound_pageTitle}>
  <section class="lost container">
    <p class="eyebrow">{notfound_label}</p>
    <h1>{notfound_heading}</h1>
    <p class="msg">{notfound_message}</p>
    <a class="btn" href="/">{notfound_buttonLabel} <span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--nav-h);
  }

  .msg {
    margin: 0 0 2.5rem;
    color: var(--fg-muted);
  }
</style>
