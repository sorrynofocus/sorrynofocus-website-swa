---
// Row of social icons. The links come from SOCIAL_LINKS in src/consts.ts.
import { SOCIAL_LINKS } from '../consts';
import { ICONS } from './icons';
---

<ul class="social">
  {
    SOCIAL_LINKS.map(({ label, icon, href }) => (
      <li>
        <a href={href} target="_blank" rel="noopener me" aria-label={label} title={label}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d={ICONS[icon]} fill-rule={icon === 'linkedin' ? 'evenodd' : undefined} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    /* Pull the row out by the hover-box padding so the glyphs line up with the text edges */
    margin: 0 -11px;
    padding: 0;
  }

  a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  a:hover {
    color: var(--fg);
    border-color: var(--line);
  }
</style>
