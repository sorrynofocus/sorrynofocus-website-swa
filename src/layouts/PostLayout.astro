---
import BaseLayout from './BaseLayout.astro';
import { formatDate, tagSlug, type Post } from '../lib/posts';
import { blog_backToAll, blog_updatedPrefix } from '../consts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article>
    <header class="post-head container">
      <a href="/blog/" class="back eyebrow">&larr; {blog_backToAll}</a>
      <p class="eyebrow">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> / {blog_updatedPrefix} {formatDate(updatedDate)}</span>}
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <figure class="hero-img">
          <img src={heroImage} alt="" />
        </figure>
      )
    }

    <div class="prose container">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    max-width: calc(var(--prose-w) + 2 * var(--gutter));
    padding-top: calc(var(--nav-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: 3rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--fg);
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
  }

  .lede {
    margin: 0 0 2rem;
    font-size: 1.2rem;
    color: var(--fg-muted);
  }

  .hero-img {
    margin: 0 0 4rem;
  }

  .hero-img img {
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
  }

  /* ---------- Markdown content styling ---------- */
  .prose {
    max-width: calc(var(--prose-w) + 2 * var(--gutter));
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }
</style>
